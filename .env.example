# ============================================================
# YouTube AI Manager — environment variables
# Copy to .env for local development. In production set these
# in Railway (backend + worker) and Vercel (frontend).
# NEVER commit a real .env file.
# ============================================================

# ---------- Core (backend + worker) ----------
# Postgres connection string. Railway provides DATABASE_URL automatically.
DATABASE_URL=postgresql://yam:yam@localhost:5432/yam
# Redis connection string (Celery broker + locks). Railway provides REDIS_URL.
REDIS_URL=redis://localhost:6379/0
# Long random string used to log in to the dashboard (you type it once).
ADMIN_TOKEN=change-me-to-a-long-random-string
# Long random string; used to encrypt the YouTube refresh token in the DB.
# Generate: python -c "import secrets;print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-to-another-long-random-string
# Public URL of the backend (used for the Google OAuth redirect URI).
BACKEND_PUBLIC_URL=http://localhost:8000
# Public URL of the dashboard (CORS + post-OAuth redirect).
FRONTEND_URL=http://localhost:3000
# IANA timezone used for the publishing schedule.
TIMEZONE=UTC

# ---------- LLM (any OpenAI-compatible API, incl. OpenRouter) ----------
# OpenAI:      https://api.openai.com/v1
# OpenRouter:  https://openrouter.ai/api/v1
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=
LLM_MODEL=openai/gpt-4o-mini
# Optional second model used if the main one keeps failing.
LLM_FALLBACK_MODEL=
# Optional OpenRouter attribution headers.
LLM_HTTP_REFERER=
LLM_APP_TITLE=YouTube AI Manager

# ---------- Voice-over (TTS) ----------
# "edge"   = free Microsoft Edge neural voices (no key, unofficial endpoint)
# "openai" = OpenAI-compatible /audio/speech endpoint
TTS_PROVIDER=edge
# Only for TTS_PROVIDER=openai. Falls back to LLM_BASE_URL / LLM_API_KEY if empty.
TTS_BASE_URL=
TTS_API_KEY=
TTS_MODEL=gpt-4o-mini-tts
TTS_VOICE=alloy

# ---------- Licensed stock footage ----------
# Pexels (free key: https://www.pexels.com/api/) — license allows free commercial use.
PEXELS_API_KEY=
# Pixabay (free key: https://pixabay.com/api/docs/) — optional second source.
PIXABAY_API_KEY=

# ---------- Google / YouTube ----------
# Create an OAuth client ("Web application") in Google Cloud Console.
# Authorized redirect URI:  <BACKEND_PUBLIC_URL>/api/youtube/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional API key for public trend lookups (YouTube Data API). OAuth is used otherwise.
YOUTUBE_API_KEY=

# ---------- Storage ----------
# "local" = files in DATA_DIR (dev / single machine)
# "s3"    = any S3-compatible bucket (Cloudflare R2, Backblaze B2, AWS S3, Railway Bucket)
STORAGE_BACKEND=local
DATA_DIR=./data
S3_ENDPOINT_URL=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=auto

# ---------- Frontend (Vercel) ----------
# Where the Next.js server reaches the backend (server-side proxy; token stays server-side).
BACKEND_URL=http://localhost:8000
